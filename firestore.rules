rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'bio', 'location', 'themePreference', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
        (!('themePreference' in data) || (data.themePreference in ['dark', 'light', 'system'])) &&
        (!('notificationsEnabled' in data) || data.notificationsEnabled is bool);
    }

    function isValidFeedItem(data) {
      return data.keys().hasAll(['id', 'title', 'imageUrl', 'authorId', 'authorName']) &&
        data.keys().hasOnly(['id', 'title', 'subtitle', 'category', 'imageUrl', 'authorId', 'authorName', 'authorAvatar', 'likesCount', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500 &&
        data.authorId is string && isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 80 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 300)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500)) &&
        (!('likesCount' in data) || data.likesCount is number);
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['itemId']) &&
        data.keys().hasOnly(['itemId', 'addedAt']) &&
        data.itemId is string && isValidId(data.itemId);
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
        incoming().userId == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
        incoming().userId == existing().userId && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      // User bookmarks subcollection
      match /bookmarks/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
          isValidId(itemId) && isValidBookmark(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(itemId);
      }
    }

    // Public Feed Items
    match /feed/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(itemId) && isValidFeedItem(incoming()) &&
        incoming().authorId == request.auth.uid && incoming().id == itemId;
      allow update: if isSignedIn() && isValidId(itemId) && isValidFeedItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        (
          incoming().authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
        );
      allow delete: if isSignedIn() && isValidId(itemId) && existing().authorId == request.auth.uid;
    }
  }
}
